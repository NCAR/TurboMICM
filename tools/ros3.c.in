/* MICM/UCAR Rosenbrock-3, Apache-2.0. Fixed stages, original scalar order. */
static double sp_min(double a, double b) { return b < a ? b : a; }
static double sp_max(double a, double b) { return a < b ? b : a; }

static chem_result specialized_solve(chem_state *s, double dt)
{
    chem_result result = {CHEM_OK, {0}};
    if (!s || !s->model || s->model->mechanism != &@MECHANISM@ || dt < 0 || !isfinite(dt)) {
        result.status = CHEM_INVALID;
        return result;
    }
    const size_t cells = s->cells, n = @SPECIES@ * cells;
    double *restrict y = s->y;
    double *restrict yn = s->work;
    double *restrict initial = s->work + n;
    double *restrict error = s->work + 2*n;
    double *restrict k0 = s->work + 3*n;
    double *restrict k1 = s->work + 4*n;
    double *restrict k2 = s->work + 5*n;
    double hmin = 1e-15*dt, hmax = dt;
    double h = sp_min(sp_max(hmin, fabs(1e-6*dt)), fabs(hmax)), time = 0;
    int reject_last = 0, reject_more = 0;
    while ((time-dt+DBL_EPSILON) <= 0 && result.status == CHEM_OK) {
        if (result.stats.internal_steps > 1000) { result.status = CHEM_MAX_STEPS; break; }
        if ((time+0.1*h) == time || h <= sp_min(DBL_EPSILON, hmin)) {
            result.status = CHEM_SMALL_STEP; break;
        }
        h = sp_min(h, fabs(dt-time));
        memset(initial, 0, n*sizeof(double));
        forcing(s->model, cells, s->rates, y, initial);
        ++result.stats.function_calls;
        memset(s->jacobian, 0, @NNZ@*cells*sizeof(double));
        jacobian(s->model, cells, s->rates, y, s->jacobian);
        ++result.stats.jacobian_updates;
        int accepted = 0;
        while (!accepted) {
            double alpha = 1.0/(h*0.43586652150845899941601945119356);
            add_alpha(cells, s->jacobian, alpha);
            factor(cells, s->jacobian, s->scratch);
            ++result.stats.decompositions;
            memcpy(k0, initial, n*sizeof(double));
            linear(cells, s->jacobian, k0);
            #pragma omp simd
            for (size_t i=0; i<n; ++i) yn[i] = y[i] + k0[i];
            memset(k1, 0, n*sizeof(double));
            forcing(s->model, cells, s->rates, yn, k1);
            ++result.stats.function_calls;
            double c0 = -0.10156171083877702091975600115545e+01/h;
            #pragma omp simd
            for (size_t i=0; i<n; ++i) {
                k2[i] = k1[i];
                k1[i] += c0*k0[i];
            }
            linear(cells, s->jacobian, k1);
            double c1 = 0.40759956452537699824805835358067e+01/h;
            double c2 = 0.92076794298330791242156818474003e+01/h;
            #pragma omp simd
            for (size_t i=0; i<n; ++i) {
                k2[i] += c1*k0[i];
                k2[i] += c2*k1[i];
            }
            linear(cells, s->jacobian, k2);
            result.stats.solves += 3;
            #pragma omp simd
            for (size_t i=0; i<n; ++i) {
                double value = y[i];
                value += k0[i];
                value += 0.61697947043828245592553615689730e+01*k1[i];
                value += -0.42772256543218573326238373806514*k2[i];
                yn[i] = value;
                double e = 0.0;
                e += 0.5*k0[i];
                e += -0.29079558716805469821718236208017e+01*k1[i];
                e += 0.22354069897811569627360909276199*k2[i];
                error[i] = e;
            }
            /* Keep the species-major, lane-minor sequential reduction. Changing
             * its association can change adaptive step selection. */
            double sum = 0;
            for (size_t i=0; i<@SPECIES@; ++i) {
                for (size_t c=0; c<cells; ++c) {
                    size_t k = i*cells+c;
                    double ymax = sp_max(fabs(y[k]), fabs(yn[k]));
                    double e = error[k]/(s->atol[i] + s->rtol*ymax);
                    sum += e*e;
                }
            }
            double norm = sp_max(sqrt(sum/(double)n), 1e-10);
            double next = h*sp_min(6.0, sp_max(0.2, 0.9/pow(norm, 1.0/3.0)));
            ++result.stats.internal_steps;
            if (isnan(norm)) { result.status = CHEM_NAN; break; }
            if (isinf(norm)) { result.status = CHEM_INF; break; }
            if (norm < 1 || h < hmin) {
                ++result.stats.accepted;
                time += h;
                memcpy(y, yn, n*sizeof(double));
                next = sp_max(hmin, sp_min(next, hmax));
                if (reject_last) next = sp_min(next, h);
                reject_last = 0; reject_more = 0; h = next; accepted = 1;
            } else {
                if (reject_more) next = h*0.1;
                reject_more = reject_last; reject_last = 1; h = next;
                if (result.stats.accepted >= 1) ++result.stats.rejected;
                memset(s->jacobian, 0, @NNZ@*cells*sizeof(double));
                jacobian(s->model, cells, s->rates, y, s->jacobian);
                ++result.stats.jacobian_updates;
            }
        }
    }
    result.stats.final_time = time;
    return result;
}
